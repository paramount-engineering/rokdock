{
    "appId": "com.rokdock.app",
    "productName": "RokDock",
    "publish": {
        "provider": "github",
        "owner": "paramount-engineering",
        "repo": "rokdock",
        "releaseType": "draft"
    },
    "directories": {
        "output": "dist",
        "buildResources": "resources"
    },
    "files": [
        "out/**/*",
        "resources/**/*",
        "package.json"
    ],
    "asar": true,
    "asarUnpack": [
        "out/preload/**",
        "out/shared/**",
        "resources/fonts/**"
    ],
    "fileAssociations": [
        {
            "ext": "rscript",
            "name": "RokDock Script",
            "description": "RokDock automation script",
            "role": "Editor",
            "rank": "Owner",
            "mimeType": "application/x-rokdock-script"
        },
        {
            "ext": "rasp",
            "name": "Roku Automation Script",
            "description": "Roku Automation Script Protocol file",
            "role": "Editor",
            "rank": "Owner",
            "mimeType": "application/x-roku-rasp"
        },
        {
            "ext": "json",
            "role": "Editor",
            "rank": "Alternate",
            "mimeType": "application/json"
        },
        {
            "ext": "svg",
            "role": "Editor",
            "rank": "Alternate",
            "mimeType": "image/svg+xml"
        }
    ],
    "win": {
        "icon": "resources/icons/icon.ico",
        "target": [
            {
                "target": "nsis",
                "arch": [
                    "x64"
                ]
            },
            {
                "target": "portable",
                "arch": [
                    "x64"
                ]
            }
        ],
        "artifactName": "RokDock-${version}-Setup-win-x64.${ext}",
        "extraResources": [
            { "from": "build/tool-icons", "to": "icons/tools", "filter": ["*.ico"] }
        ]
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "installerIcon": "resources/icons/icon.ico",
        "uninstallerIcon": "resources/icons/icon.ico",
        "artifactName": "RokDock-${version}-Setup-win-x64.exe",
        "menuCategory": "RokDock",
        "include": "build/tool-shortcuts.nsh"
    },
    "portable": {
        "artifactName": "RokDock-${version}-Portable-win-x64.exe"
    },
    "mac": {
        "icon": "resources/icons/icon.png",
        "category": "public.app-category.developer-tools",
        "target": [
            {
                "target": "dmg",
                "arch": [
                    "x64",
                    "arm64"
                ]
            },
            {
                "target": "zip",
                "arch": [
                    "x64",
                    "arm64"
                ]
            }
        ],
        "artifactName": "RokDock-${version}-mac-${arch}.${ext}",
        "notarize": true,
        "hardenedRuntime": true,
        "entitlements": "build/entitlements.mac.plist",
        "entitlementsInherit": "build/entitlements.mac.plist",
        "extendInfo": {
            "NSCameraUsageDescription": "RokDock uses the camera to capture live video from a connected Roku HDMI capture device.",
            "NSMicrophoneUsageDescription": "RokDock uses the microphone input to capture audio from a connected Roku HDMI capture device."
        }
    },
    "dmg": {
        "artifactName": "RokDock-${version}-mac-${arch}.dmg",
        "window": {
            "x": 130,
            "y": 220,
            "width": 560,
            "height": 420
        },
        "contents": [
            { "x": 140, "y": 140, "type": "file" },
            { "x": 420, "y": 140, "type": "link", "path": "/Applications" },
            { "x": 280, "y": 320, "type": "dir", "path": "build/RokDock Tools", "name": "RokDock Tools" }
        ]
    },
    "afterPack": "build/afterPack.cjs",
    "linux": {
        "icon": "resources/icons/icon.png",
        "category": "Development",
        "maintainer": "RokDock",
        "executableName": "rokdock",
        "target": [
            {
                "target": "AppImage",
                "arch": [
                    "x64"
                ]
            },
            {
                "target": "deb",
                "arch": [
                    "x64"
                ]
            }
        ],
        "artifactName": "RokDock-${version}-linux-x64.${ext}",
        "extraFiles": [
            { "from": "build/linux", "to": "../share/applications", "filter": ["rokdock-*.desktop"] },
            { "from": "build/linux/icons", "to": "../share/icons", "filter": ["**/*"] }
        ]
    },
    "appImage": {
        "artifactName": "RokDock-${version}-linux-x64.AppImage"
    }
}